NEXT_PUBLIC_API_URL=http://localhost:5240/api

# Google Analytics 4 — Measurement ID from analytics.google.com (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager — container ID (format: GTM-XXXXXXX). Optional:
# defaults to Devliora's own container (GTM-TK49XR3M) in code. Set only
# to point a non-prod build at a different container.
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity — Project ID from clarity.microsoft.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console — the token from the "HTML tag" verification method
# (the content="..." value of the google-site-verification meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — the token from the "HTML Meta Tag" verification
# method (the content="..." value of the msvalidate.01 meta tag).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
