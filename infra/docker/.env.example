# Copy this file to .env in the same folder and set real values.
# .env is gitignored and will NOT be committed.
# If .env is absent, docker-compose falls back to dev-only defaults
# (see docker-compose.yml) - fine for local dev, NOT safe for production.

POSTGRES_USER=agencyadmin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=devliora

# Production-only (used by docker-compose.prod.yml)
JWT_SECRET_KEY=changeme_generate_a_32plus_char_random_secret
CORS_ALLOWED_ORIGIN=https://devliora.com
NEXT_PUBLIC_API_URL=https://devliora.com/api
NEXT_PUBLIC_GA_MEASUREMENT_ID=your_ga4_measurement_id
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id

# AI Assistant (Gemini API)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_DAILY_QUOTA=200

# Telegram bot (used by docker-compose.prod.yml -> Telegram__* config).
# Leave TELEGRAM_BOT_TOKEN empty to disable the Telegram integration.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=your_random_webhook_secret_token
TELEGRAM_GEMINI_API_KEY=your_gemini_api_key
TELEGRAM_GEMINI_DAILY_QUOTA=8
TELEGRAM_ADMIN_CHAT_ID=your_admin_telegram_chat_id
